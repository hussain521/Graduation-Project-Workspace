@{
    ViewData["Title"] = "إدارة المستخدمين والصلاحيات";
}

<div class="container mt-5 pt-4">
    <h2 class="text-center mb-4"><i class="fas fa-users-cog me-2"></i>إدارة المستخدمين والمؤسسة</h2>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-user-shield me-2"></i>قائمة المستخدمين بالمؤسسة</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped" id="usersTable">
                <thead>
                    <tr>
                        <th>اسم المستخدم / البريد</th>
                        <th>المؤسسة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@User.Identity.Name</td>
                        <td>المؤسسة الحالية</td>
                        <td><span class="badge bg-success">نشط</span></td>
                        <td><span class="badge bg-info">مسؤول النظام</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>