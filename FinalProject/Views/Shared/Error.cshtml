@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ في النظام";
}

<div class="container py-5 text-center">
    <div class="card shadow-lg border-0 rounded-4 mx-auto style-error-card" style="max-width: 650px; background: white;">
        <div class="card-body p-5">
            <div class="mb-4">
                <span class="badge bg-danger-subtle text-danger p-3 rounded-circle me-0">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </span>
            </div>
            
            <h2 class="fw-bold text-danger mb-3">عذراً، حدث خطأ أثناء معالجة طلبك</h2>
            <p class="text-muted fs-5 mb-4">واجه النظام مشكلة غير متوقعة. يرجى محاولة إعادة المحاولة لاحقاً أو التواصل مع الدعم الفني.</p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-light border rounded-3 text-muted text-break text-start mb-4 dir-ltr">
                    <small><strong>Request ID:</strong> <code>@Model.RequestId</code></small>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                    <i class="fas fa-arrow-right me-2"></i> العودة للخلف
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-3">
                    <i class="fas fa-home me-2"></i> الصفحة الرئيسية
                </a>
            </div>
        </div>
    </div>
</div>
