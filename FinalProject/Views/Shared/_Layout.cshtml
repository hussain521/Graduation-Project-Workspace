        // Toast notification helper powered by Toastify & SweetAlert2
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        function showSuccess(message) {
            if (typeof Toastify !== 'undefined') {
                Toastify({
                    text: message,
                    duration: 4000,
                    close: true,
                    gravity: "top",
                    position: "left",
                    style: {
                        background: "linear-gradient(135deg, #2b9348 0%, #55a630 100%)",
                        borderRadius: "10px",
                        boxShadow: "0 4px 15px rgba(43, 147, 72, 0.3)",
                        fontFamily: "Tajawal, sans-serif",
                        fontWeight: "500"
                    },
                    stopOnFocus: true
                }).showToast();
            } else {
                Toast.fire({ icon: 'success', title: message });
            }
        }

        function showError(message, selector) {
            if (typeof Toastify !== 'undefined') {
                Toastify({
                    text: message || "حدث خطأ غير متوقع",
                    duration: 5000,
                    close: true,
                    gravity: "top",
                    position: "left",
                    style: {
                        background: "linear-gradient(135deg, #d90429 0%, #ef233c 100%)",
                        borderRadius: "10px",
                        boxShadow: "0 4px 15px rgba(217, 4, 41, 0.3)",
                        fontFamily: "Tajawal, sans-serif",
                        fontWeight: "500"
                    },
                    stopOnFocus: true
                }).showToast();
            } else {
                Toast.fire({ icon: 'error', title: message || "حدث خطأ غير متوقع" });
            }
            if (selector) $(selector).focus();
        }

        function showWarning(message) {
            Toastify({
                text: message,
                duration: 4500,
                close: true,
                gravity: "top",
                position: "left",
                style: {
                    background: "linear-gradient(135deg, #f77f00 0%, #fcbf49 100%)",
                    borderRadius: "10px",
                    boxShadow: "0 4px 15px rgba(247, 127, 0, 0.3)",
                    fontFamily: "Tajawal, sans-serif",
                    fontWeight: "500"
                },
                stopOnFocus: true
            }).showToast();
        }

        function showInfo(message) {
            Toastify({
                text: message,
                duration: 4000,
                close: true,
                gravity: "top",
                position: "left",
                style: {
                    background: "linear-gradient(135deg, #4361ee 0%, #4cc9f0 100%)",
                    borderRadius: "10px",
                    boxShadow: "0 4px 15px rgba(67, 97, 238, 0.3)",
                    fontFamily: "Tajawal, sans-serif",
                    fontWeight: "500"
                },
                stopOnFocus: true
            }).showToast();
        }

        // Unified SweetAlert confirmation dialog
        function confirmAction(title, text, confirmButtonText, onConfirm) {
            Swal.fire({
                title: title || 'هل أنت متأكد؟',
                text: text || 'لن تمكن من التراجع عن هذه العملية!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4361ee',
                cancelButtonColor: '#d33',
                confirmButtonText: confirmButtonText || 'نعم، قم بالتأكيد',
                cancelButtonText: 'إلغاء',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    onConfirm();
                }
            });
        }

        function setReadOnly(selector, value) {
            if (value == true) {
                $(selector).removeClass("editable");
                $(selector).addClass("readonly");
            }
            else if (value == false) {
                $(selector).removeClass("readonly");
                $(selector).addClass("editable");
            }

            $(selector).find("input").prop('readonly', value);
            $(selector).find("select").prop('readonly', value);
            $(selector).find("select").prop('disabled', value);
        }

        function setEnabled(selector, value) {
            $(selector).prop('disabled', !value);
        }

        function isInRole(roleId) {
            //var result = false;    
            return $.getJSON("../Users/IsInRole", { RoleId: roleId },
                function (response) {
                    result = response;
                    return result;
                });
        }

        function openWindowWithPost(url, name, params) {
            /*var timeStampInMs = new Date().getTime();
            name = name + timeStampInMs;*/
            console.log("name:" + name);
            var form = document.createElement("form");
            form.setAttribute("method", "post");
            form.setAttribute("action", url);
            form.setAttribute("target", name);
            for (var i in params) {
                if (params.hasOwnProperty(i)) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = i;
                    input.value = params[i];
                    form.appendChild(input);
                }
            }
            document.body.appendChild(form);
            window.open("post.htm", name, "width=" + screen.availWidth + ",height=" + screen.availHeight);
            form.submit();
            document.body.removeChild(form);
        }

    </script>

    @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>