            try {
                // التحقق مما إذا كانت صفحة الأصناف أو الحسابات مفتوحة
                if (window.location.pathname.includes("Items") || window.location.pathname.includes("Accounts")) {
                    window.history.back(); // إرجاع المستخدم للخلف (إغلاق الصفحة الحالية)
                    setTimeout(async () => {
