    }
    else
    {

    }
    <!-- Main Content -->
    <div class="main-content" id="mainContent" style="@(!User.Identity.IsAuthenticated ? "margin-right: 0;" : "")">
        <div class="container-fluid p-4">
            <!-- Global TempData Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show custom-alert-banner d-flex align-items-center" role="alert">
                    <i class="fas fa-check-circle me-2 fa-lg"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show custom-alert-banner d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-triangle me-2 fa-lg"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show custom-alert-banner d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-circle me-2 fa-lg"></i>
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show custom-alert-banner d-flex align-items-center" role="alert">
                    <i class="fas fa-info-circle me-2 fa-lg"></i>
                    <div>@TempData["InfoMessage"]</div>
                    <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer text-center mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year - نظام دفتر الحسابات الشخصي السحابي - جميع الحقوق محفوظة
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Popper.js and Bootstrap 5 JS -->
