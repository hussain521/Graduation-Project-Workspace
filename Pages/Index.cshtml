@page
@model GraduationProject.Pages.IndexModel
@{
    ViewData["Title"] = "Workspace Dashboard";
}

<div class="max-w-[1400px] mx-auto px-4 sm:px-6 space-y-16">

    <!-- Asymmetric Split Hero Section (Rule 1 & Rule 3: No gradient text, solid accent span) -->
    <section class="relative rounded-3xl bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 sm:p-12 overflow-hidden shadow-2xl shadow-black/40">
        <div class="absolute -right-24 -top-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            <!-- Left Aligned Copy -->
            <div class="lg:col-span-7 space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Academic Year 2025-2026 Live Portal</span>
                </div>

                <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none text-white">
                    Senior Engineering <span class="text-emerald-400">Graduation Workspace</span>
                </h1>

                <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
                    Collaborate, track milestones, schedule defense hearings, and assess senior capstone engineering projects with real-time rubric evaluations.
                </p>

                <div class="flex flex-wrap items-center gap-4 pt-2">
                    <a asp-page="/Projects" class="px-6 py-3.5 rounded-full bg-emerald-500 text-slate-950 font-semibold hover:bg-emerald-400 active:scale-95 transition-all shadow-lg shadow-emerald-500/25 flex items-center gap-2 text-sm">
                        <span>Explore Project Catalog</span>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </a>
                    <a asp-page="/Kanban" class="px-6 py-3.5 rounded-full bg-slate-800 text-slate-200 font-medium hover:bg-slate-700 active:scale-95 transition-all flex items-center gap-2 text-sm">
                        <span>Milestone Board</span>
                    </a>
                    <a asp-page="/Defense" class="px-6 py-3.5 rounded-full bg-slate-800/60 text-slate-300 font-medium hover:bg-slate-700 active:scale-95 transition-all flex items-center gap-2 text-sm">
                        <span>Committee Rubric</span>
                    </a>
                </div>
            </div>

            <!-- Right Visual Stat Cards Grid (Bento Style) -->
            <div class="lg:col-span-5 grid grid-cols-2 gap-4">
                <div class="p-6 rounded-2xl bg-slate-800/70 backdrop-blur-sm space-y-2">
                    <span class="text-xs font-mono text-slate-400 uppercase">Active Projects</span>
                    <div class="font-display text-3xl sm:text-4xl font-black text-white font-mono">@Model.TotalProjects</div>
                    <p class="text-xs text-emerald-400 flex items-center gap-1 font-medium">
                        <span>@Model.DefendedProjects Defended</span>
                        <span>•</span>
                        <span>@Model.InProgressProjects In Progress</span>
                    </p>
                </div>

                <div class="p-6 rounded-2xl bg-slate-800/70 backdrop-blur-sm space-y-2">
                    <span class="text-xs font-mono text-slate-400 uppercase">Graduating Seniors</span>
                    <div class="font-display text-3xl sm:text-4xl font-black text-white font-mono">@Model.TotalStudents</div>
                    <p class="text-xs text-slate-400">Computer Science & Eng.</p>
                </div>

                <div class="p-6 rounded-2xl bg-slate-800/70 backdrop-blur-sm space-y-2">
                    <span class="text-xs font-mono text-slate-400 uppercase">Faculty Advisors</span>
                    <div class="font-display text-3xl sm:text-4xl font-black text-white font-mono">@Model.TotalSupervisors</div>
                    <p class="text-xs text-slate-400">Research Professors</p>
                </div>

                <div class="p-6 rounded-2xl bg-emerald-950/40 border-0 p-6 space-y-2">
                    <span class="text-xs font-mono text-emerald-400 uppercase">Average Grade</span>
                    <div class="font-display text-3xl sm:text-4xl font-black text-emerald-400 font-mono">@Model.AverageScore<span class="text-lg text-emerald-500/70 font-sans">%</span></div>
                    <p class="text-xs text-slate-300">Defense Committee Avg</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Important Announcements & Upcoming Defenses (2-Column Bento) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Announcements Column (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-display text-2xl font-bold text-white">Official Notices</h2>
                    <p class="text-sm text-slate-400">Committee guidelines, deadlines, and requirements</p>
                </div>
                <span class="text-xs font-mono text-emerald-400 px-3 py-1 rounded-full bg-emerald-500/10">Active Term</span>
            </div>

            <div class="space-y-4">
                @foreach (var item in Model.RecentAnnouncements)
                {
                    var badgeBg = item.Priority == "Urgent" ? "bg-rose-500/10 text-rose-400" : "bg-emerald-500/10 text-emerald-400";
                    <div class="p-6 rounded-2xl bg-slate-900/80 hover:bg-slate-850 transition-colors space-y-3">
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-xs font-mono uppercase px-2.5 py-1 rounded-md @badgeBg font-medium">@item.Category &bull; @item.Priority</span>
                            <span class="text-xs font-mono text-slate-400">@item.PublishedDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <h3 class="text-lg font-bold text-white">@item.Title</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">@item.Content</p>
                        @if (!string.IsNullOrEmpty(item.ActionLabel))
                        {
                            <a href="@item.ActionUrl" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors">
                                <span>@item.ActionLabel</span>
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Defense Schedule Column (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="font-display text-2xl font-bold text-white">Defense Hearings</h2>
                    <p class="text-sm text-slate-400">Upcoming committee sessions</p>
                </div>
                <a asp-page="/Defense" class="text-xs font-mono text-emerald-400 hover:underline">View All &rarr;</a>
            </div>

            <div class="space-y-4">
                @if (Model.UpcomingDefenses.Any())
                {
                    @foreach (var defense in Model.UpcomingDefenses)
                    {
                        <div class="p-5 rounded-2xl bg-slate-900/80 hover:bg-slate-850 transition-colors space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <span class="text-xs font-mono text-emerald-400 block">@defense.DefenseDate?.ToString("ddd, MMM dd @ h:mm tt")</span>
                                    <h4 class="text-base font-bold text-white mt-1 line-clamp-1">@defense.Title</h4>
                                </div>
                            </div>
                            <div class="flex items-center justify-between text-xs text-slate-400 pt-1">
                                <span class="flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    @defense.DefenseRoom
                                </span>
                                <span class="text-slate-300 font-medium">Adv: @defense.Supervisor?.FullName</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 rounded-2xl bg-slate-900/50 text-center text-slate-400 text-sm">
                        No upcoming defense sessions scheduled for this week.
                    </div>
                }
            </div>
        </div>

    </section>

    <!-- Top Featured Capstone Projects -->
    <section class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <h2 class="font-display text-3xl font-bold text-white">Distinguished Projects</h2>
                <p class="text-sm text-slate-400 mt-1">High-impact engineering work evaluated by faculty juries</p>
            </div>
            <a asp-page="/Projects" class="text-sm font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1.5">
                <span>Browse all @Model.TotalProjects projects</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var p in Model.FeaturedProjects)
            {
                <div class="p-6 rounded-3xl bg-slate-900/80 hover:bg-slate-850 transition-all flex flex-col justify-between space-y-6 group">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-xs font-mono uppercase px-3 py-1 rounded-full bg-slate-800 text-slate-300">
                                @p.Track.ToString()
                            </span>
                            @if (p.FinalGrade.HasValue)
                            {
                                <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400">
                                    Grade: @p.FinalGrade%
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-slate-800 text-slate-400">
                                    @p.Status.ToString()
                                </span>
                            }
                        </div>

                        <h3 class="font-display text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                            @p.Title
                        </h3>

                        <p class="text-sm text-slate-300 line-clamp-3 leading-relaxed">
                            @p.Abstract
                        </p>
                    </div>

                    <div class="space-y-4 pt-4">
                        <div class="flex flex-wrap gap-1.5">
                            @if (!string.IsNullOrEmpty(p.TechStack))
                            {
                                @foreach (var tech in p.TechStack.Split(',').Take(4))
                                {
                                    <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-slate-800/80 text-slate-300">@tech.Trim()</span>
                                }
                            }
                        </div>

                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-center gap-2">
                                @if (p.Supervisor != null)
                                {
                                    <img src="@p.Supervisor.AvatarUrl" alt="@p.Supervisor.FullName" class="w-7 h-7 rounded-full object-cover bg-slate-800" />
                                    <span class="text-xs text-slate-400">Adv: <strong class="text-slate-200 font-medium">@p.Supervisor.FullName</strong></span>
                                }
                            </div>
                            <a href="/Projects?id=@p.Id" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">
                                View Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

</div>