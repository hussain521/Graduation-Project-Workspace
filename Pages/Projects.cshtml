@page
@model GraduationProject.Pages.ProjectsModel
@using GraduationProject.Models
@{
    ViewData["Title"] = "Project Catalog";
}

<div class="max-w-[1400px] mx-auto px-4 sm:px-6 space-y-12">

    <!-- Header & Filter Bar -->
    <div class="space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-white">
                    Capstone <span class="text-emerald-400">Projects Directory</span>
                </h1>
                <p class="text-sm sm:text-base text-slate-300 mt-1">
                    Explore senior design prototypes, research papers, and software systems.
                </p>
            </div>
            <button onclick="openSubmitModal()" class="px-5 py-2.5 rounded-full bg-emerald-500 text-slate-950 font-semibold hover:bg-emerald-400 active:scale-95 transition-all text-sm flex items-center gap-2 shadow-lg shadow-emerald-500/20 whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                <span>Propose New Project</span>
            </button>
        </div>

        <!-- Filter Controls -->
        <form method="get" class="p-4 rounded-2xl bg-slate-900/90 flex flex-wrap items-center gap-4 text-sm">
            <div class="flex-1 min-w-[240px]">
                <div class="relative">
                    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by title, keywords, tech stack..." 
                           class="w-full bg-slate-800 text-slate-100 placeholder-slate-400 rounded-xl px-4 py-2.5 pl-10 focus:outline-none focus:ring-2 focus:ring-emerald-400" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
            </div>

            <div class="w-full sm:w-auto">
                <select name="track" onchange="this.form.submit()" class="w-full bg-slate-800 text-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                    <option value="">All Engineering Tracks</option>
                    @foreach (ProjectTrack t in Enum.GetValues(typeof(ProjectTrack)))
                    {
                        <option value="@t" selected="@(Model.SelectedTrack == t)">@t.ToString()</option>
                    }
                </select>
            </div>

            <div class="w-full sm:w-auto">
                <select name="status" onchange="this.form.submit()" class="w-full bg-slate-800 text-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-emerald-400">
                    <option value="">All Statuses</option>
                    @foreach (ProjectStatus s in Enum.GetValues(typeof(ProjectStatus)))
                    {
                        <option value="@s" selected="@(Model.SelectedStatus == s)">@s.ToString()</option>
                    }
                </select>
            </div>

            <button type="submit" class="px-5 py-2.5 rounded-xl bg-slate-800 text-slate-200 font-medium hover:bg-slate-700 transition-colors">
                Apply Filters
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedTrack.HasValue || Model.SelectedStatus.HasValue)
            {
                <a asp-page="/Projects" class="text-xs font-mono text-rose-400 hover:underline py-2">Reset</a>
            }
        </form>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model.Projects.Any())
        {
            @foreach (var p in Model.Projects)
            {
                <div class="rounded-3xl bg-slate-900/80 hover:bg-slate-850 transition-all flex flex-col justify-between overflow-hidden group">
                    <div class="relative h-44 overflow-hidden bg-slate-950">
                        <img src="@p.ThumbnailUrl" alt="@p.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/30 to-transparent"></div>
                        <span class="absolute top-4 left-4 text-xs font-mono uppercase px-3 py-1 rounded-full bg-slate-900/90 backdrop-blur-md text-emerald-400 font-medium">
                            @p.Track.ToString()
                        </span>
                        @if (p.FinalGrade.HasValue)
                        {
                            <span class="absolute top-4 right-4 text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-emerald-500 text-slate-950">
                                @p.FinalGrade%
                            </span>
                        }
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between space-y-6">
                        <div class="space-y-3">
                            <h3 class="font-display text-lg font-bold text-white line-clamp-2 group-hover:text-emerald-400 transition-colors">
                                @p.Title
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-300 line-clamp-3 leading-relaxed">
                                @p.Abstract
                            </p>
                        </div>

                        <div class="space-y-4 pt-2">
                            <!-- Team & Advisor -->
                            <div class="space-y-2 text-xs text-slate-400">
                                <div class="flex items-center justify-between">
                                    <span>Advisor: <strong class="text-slate-200">@(p.Supervisor != null ? p.Supervisor.FullName : "TBD")</strong></span>
                                    <span>Team: <strong class="text-slate-200">@p.TeamMembers.Count members</strong></span>
                                </div>
                                <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                    @{
                                        var completed = p.Milestones.Count(m => m.Status == MilestoneStatus.Approved);
                                        var total = p.Milestones.Count > 0 ? p.Milestones.Count : 1;
                                        var pct = (int)((completed / (double)total) * 100);
                                    }
                                    <div class="bg-emerald-500 h-full rounded-full" style="width: @pct%"></div>
                                </div>
                                <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
                                    <span>Milestones: @completed/@p.Milestones.Count</span>
                                    <span>@pct% Completed</span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="flex items-center justify-between pt-2">
                                <span class="text-xs font-mono text-slate-400">@p.AcademicYear</span>
                                <a href="/Projects?id=@p.Id" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-slate-200 text-xs font-semibold transition-all">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full p-12 text-center rounded-3xl bg-slate-900/50 space-y-3">
                <p class="text-base text-slate-300">No projects found matching your search or filter criteria.</p>
                <a asp-page="/Projects" class="inline-block text-xs font-mono text-emerald-400 hover:underline">Reset Filters</a>
            </div>
        }
    </div>

    <!-- Project Details Modal (If ?id=X is present) -->
    @if (Model.ModalProject != null)
    {
        var p = Model.ModalProject;
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto">
            <div class="relative w-full max-w-4xl rounded-3xl bg-slate-900 p-6 sm:p-8 space-y-8 my-8 shadow-2xl max-h-[90vh] overflow-y-auto">
                <a asp-page="/Projects" class="absolute top-6 right-6 p-2 rounded-full bg-slate-800 text-slate-400 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </a>

                <div class="space-y-3 pr-10">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-mono uppercase px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 font-medium">
                            @p.Track.ToString()
                        </span>
                        <span class="text-xs font-mono px-3 py-1 rounded-full bg-slate-800 text-slate-300">
                            Status: @p.Status.ToString()
                        </span>
                        @if (p.FinalGrade.HasValue)
                        {
                            <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-emerald-500 text-slate-950">
                                Final Grade: @p.FinalGrade%
                            </span>
                        }
                    </div>
                    <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">@p.Title</h2>
                </div>

                <div class="space-y-4">
                    <h4 class="text-xs font-mono text-emerald-400 uppercase tracking-wider">Executive Abstract</h4>
                    <p class="text-sm sm:text-base text-slate-300 leading-relaxed bg-slate-950 p-5 rounded-2xl">
                        @p.Abstract
                    </p>
                </div>

                <!-- Team Members & Advisor -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-5 rounded-2xl bg-slate-850 space-y-3">
                        <h4 class="text-xs font-mono text-slate-400 uppercase">Supervisor & Department</h4>
                        @if (p.Supervisor != null)
                        {
                            <div class="flex items-center gap-3">
                                <img src="@p.Supervisor.AvatarUrl" class="w-12 h-12 rounded-full object-cover" />
                                <div>
                                    <h5 class="text-sm font-bold text-white">@p.Supervisor.Title @p.Supervisor.FullName</h5>
                                    <p class="text-xs text-slate-400">@p.Supervisor.Department</p>
                                    <p class="text-xs font-mono text-emerald-400">@p.Supervisor.Email</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-850 space-y-3">
                        <h4 class="text-xs font-mono text-slate-400 uppercase">Student Engineering Team</h4>
                        <div class="space-y-2 max-h-40 overflow-y-auto">
                            @foreach (var m in p.TeamMembers)
                            {
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-medium text-slate-200">@m.FullName</span>
                                    <span class="font-mono text-slate-400">@m.Role</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Milestones Timeline -->
                <div class="space-y-3">
                    <h4 class="text-xs font-mono text-emerald-400 uppercase">Milestones & Deliverables</h4>
                    <div class="space-y-2">
                        @foreach (var ms in p.Milestones.OrderBy(x => x.DueDate))
                        {
                            <div class="p-3.5 rounded-xl bg-slate-950 flex items-center justify-between gap-4 text-xs">
                                <div>
                                    <div class="font-semibold text-slate-200">@ms.Title</div>
                                    <div class="text-slate-400 text-[11px]">Due: @ms.DueDate.ToString("MMM dd, yyyy") &bull; Weight: @ms.WeightPercentage%</div>
                                </div>
                                <span class="font-mono px-2.5 py-1 rounded-md bg-slate-800 text-slate-300">
                                    @ms.Status.ToString()
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4">
                    <a asp-page="/Projects" class="px-6 py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-medium hover:bg-slate-700 transition-colors">
                        Close
                    </a>
                    <a href="/Defense?projectId=@p.Id" class="px-6 py-2.5 rounded-xl bg-emerald-500 text-slate-950 text-xs font-bold hover:bg-emerald-400 transition-colors">
                        Open Evaluation Rubric
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Submit Proposal Modal -->
    <div id="submitModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm overflow-y-auto">
        <div class="relative w-full max-w-2xl rounded-3xl bg-slate-900 p-6 sm:p-8 space-y-6 my-8 shadow-2xl">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="font-display text-2xl font-bold text-white">Propose Graduation Project</h3>
                    <p class="text-xs sm:text-sm text-slate-400">Submit your capstone concept for faculty review</p>
                </div>
                <button onclick="closeSubmitModal()" class="p-2 rounded-full bg-slate-800 text-slate-400 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="proposalForm" onsubmit="handleProposalSubmit(event)" class="space-y-4 text-sm">
                <div>
                    <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Project Title *</label>
                    <input type="text" id="propTitle" required placeholder="e.g. Autonomous Robotic Surgery Simulation System" class="w-full bg-slate-800 text-slate-100 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Engineering Track *</label>
                        <select id="propTrack" class="w-full bg-slate-800 text-slate-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none">
                            @foreach (ProjectTrack t in Enum.GetValues(typeof(ProjectTrack)))
                            {
                                <option value="@((int)t)">@t.ToString()</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Preferred Advisor</label>
                        <select id="propSupervisor" class="w-full bg-slate-800 text-slate-200 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none">
                            <option value="">-- Select Advisor --</option>
                            @foreach (var sup in Model.Supervisors)
                            {
                                <option value="@sup.Id">@sup.Title @sup.FullName</option>
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Executive Abstract *</label>
                    <textarea id="propAbstract" required rows="3" placeholder="Summarize problem statement, approach, methodology and target outcomes..." class="w-full bg-slate-800 text-slate-100 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Technologies & Stack</label>
                    <input type="text" id="propTech" placeholder="e.g. C#, ASP.NET Core, PyTorch, React, Docker" class="w-full bg-slate-800 text-slate-100 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Lead Student Name *</label>
                        <input type="text" id="propLeadName" required placeholder="e.g. Hussain Al-Ahmad" class="w-full bg-slate-800 text-slate-100 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Student University ID</label>
                        <input type="text" id="propLeadId" placeholder="e.g. ST-2022-9012" class="w-full bg-slate-800 text-slate-100 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-400 outline-none" />
                    </div>
                </div>

                <div id="submitAlert" class="hidden p-3 rounded-xl bg-emerald-500/10 text-emerald-400 text-xs"></div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeSubmitModal()" class="px-5 py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-medium hover:bg-slate-700 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="submitBtn" class="px-6 py-2.5 rounded-xl bg-emerald-500 text-slate-950 text-xs font-bold hover:bg-emerald-400 active:scale-95 transition-all">
                        Submit Proposal
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
    function openSubmitModal() {
        document.getElementById('submitModal').classList.remove('hidden');
    }

    function closeSubmitModal() {
        document.getElementById('submitModal').classList.add('hidden');
    }

    async function handleProposalSubmit(e) {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        const alertBox = document.getElementById('submitAlert');
        btn.disabled = true;
        btn.innerText = "Submitting...";

        const payload = {
            title: document.getElementById('propTitle').value,
            track: parseInt(document.getElementById('propTrack').value),
            supervisorId: document.getElementById('propSupervisor').value ? parseInt(document.getElementById('propSupervisor').value) : null,
            abstract: document.getElementById('propAbstract').value,
            techStack: document.getElementById('propTech').value,
            teamMembers: [
                {
                    fullName: document.getElementById('propLeadName').value,
                    studentId: document.getElementById('propLeadId').value || "ST-2022-9999",
                    role: "Team Lead",
                    major: "Software Engineering"
                }
            ]
        };

        try {
            const resp = await fetch('/api/Projects', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (resp.ok) {
                alertBox.classList.remove('hidden');
                alertBox.innerText = "Proposal submitted successfully! Refreshing directory...";
                setTimeout(() => {
                    window.location.href = '/Projects';
                }, 1000);
            } else {
                alert("Error submitting proposal. Please verify all required fields.");
                btn.disabled = false;
                btn.innerText = "Submit Proposal";
            }
        } catch (err) {
            console.error(err);
            alert("Network error submitting proposal.");
            btn.disabled = false;
            btn.innerText = "Submit Proposal";
        }
    }

    // Auto open submit modal if #submit in hash
    if (window.location.hash === '#submit') {
        openSubmitModal();
    }
</script>