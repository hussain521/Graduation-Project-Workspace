@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}
@model AccountingERP.Models.LoginViewModel

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - نظام السجلات والمحاسبة ERP</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f766e 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
            padding: 40px;
            width: 100%;
            max-width: 440px;
        }
        .btn-teal {
            background-color: #0f766e;
            color: #ffffff;
            font-weight: 700;
            padding: 12px;
            border-radius: 12px;
            border: none;
        }
        .btn-teal:hover {
            background-color: #115e59;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-teal-50 rounded-circle p-3 mb-2" style="width: 70px; height: 70px; background-color: #ccfbf1;">
                <i class="fa-solid fa-calculator fa-2x text-teal" style="color: #0f766e;"></i>
            </div>
            <h4 class="fw-bold mt-2">النظام المحاسبي المتكامل ERP</h4>
            <p class="text-muted small">سجّل دخولك للوصول إلى الحسابات والتقارير المالية</p>
        </div>

        <form asp-controller="Auth" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="text-start mb-3">
                <label class="form-label fw-bold small">اسم المستخدم</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                    <input asp-for="Username" class="form-control" placeholder="أدخل اسم المستخدم (مثال: admin)" autofocus />
                </div>
            </div>

            <div class="text-start mb-4">
                <label class="form-label fw-bold small">كلمة المرور</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control" type="password" placeholder="أدخل كلمة المرور" />
                </div>
            </div>

            <button type="submit" class="btn btn-teal w-full w-100 mb-3">
                <i class="fa-solid fa-right-to-bracket me-2"></i> تسجيل الدخول
            </button>
        </form>

        <div class="p-3 bg-light rounded-3 text-start small">
            <span class="fw-bold text-dark d-block mb-1"><i class="fa-solid fa-key text-warning me-1"></i> بيانات الدخول الافتراضية:</span>
            <div>اسم المستخدم: <code>admin</code></div>
            <div>كلمة المرور: <code>Admin@123456</code></div>
        </div>
    </div>
</body>
</html>